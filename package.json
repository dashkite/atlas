{
  "name": "@dashkite/atlas",
  "version": "0.12.41",
  "description": "Generate import maps",
  "keywords": [
    "import maps"
  ],
  "homepage": "https://github.com/dashkite/atlas#readme",
  "repository": "github:dashkite/atlas",
  "license": "See license in LICENSE.md",
  "author": "Dan Yoder",
  "exports": {
    ".": {
      "node": "./build/node/src/index.js"
    },
    "./generators": {
      "node": "./build/node/src/generators/index.js"
    },
    "./generators/*.js": {
      "node": "./build/node/src/generators/*.js"
    },
    "./presets/*": {
      "node": "./build/node/src/presets/*.js"
    }
  },
  "imports": {
    "#helpers/*": {
      "node": "./build/node/src/helpers/*.js"
    },
    "#generators": {
      "node": "./build/node/src/generators/index.js"
    },
    "#generators/*": {
      "node": "./build/node/src/generators/*.js"
    }
  },
  "files": [
    "build/node/src",
    "build/browser/src"
  ],
  "scripts": {
    "build": "genie build",
    "test": "genie test",
    "release": "genie release"
  },
  "dependencies": {
    "@dashkite/drn-sky": "^0.8.19",
    "@dashkite/joy": "^0.7.0",
    "@dashkite/polaris": "^0.10.38",
    "@dashkite/zephyr": "^0.9.0",
    "esbuild": "^0.19.12",
    "js-yaml": "^4.2.0",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@dashkite/amen": "^0.5.0",
    "@dashkite/amen-console": "^0.4.0",
    "@dashkite/assert": "^0.3.0",
    "@dashkite/genie": "^0.20.16",
    "@dashkite/genie-clean": "^0.9.0",
    "@dashkite/genie-coffee": "^0.9.0",
    "@dashkite/genie-release": "^0.5.2"
  }
}
